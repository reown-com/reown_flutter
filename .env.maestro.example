# WalletConnect Pay merchant credentials for Maestro E2E tests.
# Copy this file to .env.maestro and fill in the values.
# These are loaded at runtime by run-maestro-pay-tests.sh.
#
# NOTE: TEST_WALLET_PRIVATE_KEY is NOT here — it's a build-time --dart-define param,
# not a Maestro env var. Pass it when building the APK:
#   flutter build apk --dart-define="TEST_WALLET_PRIVATE_KEY=<hex-key>"

WPAY_CUSTOMER_KEY_SINGLE_NOKYC=
WPAY_MERCHANT_ID_SINGLE_NOKYC=
WPAY_CUSTOMER_KEY_MULTI_NOKYC=
WPAY_MERCHANT_ID_MULTI_NOKYC=
WPAY_CUSTOMER_KEY_MULTI_KYC=
WPAY_MERCHANT_ID_MULTI_KYC=
